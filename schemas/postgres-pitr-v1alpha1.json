{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis.invalid/schemas/postgres-pitr-v1alpha1.json",
  "title": "Disposable PostgreSQL physical PITR contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "workflow", "scenario", "maxRecoveryMillis", "maxLostCommits", "maxBackupBytes", "maxWalBytes"],
  "properties": {
    "version": {"const": "themis.postgres-pitr/v1alpha1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "workflow": {"const": "physical-named-target-sigkill-v1"},
    "scenario": {"enum": ["healthy", "ack-loss", "missing-wal", "cleanup-denied", "inflight-crash"]},
    "maxRecoveryMillis": {"type": "integer", "minimum": 1, "maximum": 60000},
    "maxLostCommits": {"const": 0},
    "maxBackupBytes": {"const": 67108864},
    "maxWalBytes": {"const": 33554432}
  }
}
