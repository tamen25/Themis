{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:themis:evidence-bundle:v1alpha1",
  "title": "Themis evidence bundle manifest (canonical bytes and cryptographic checks additionally required)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "serialization", "bundleId", "source", "publisher", "publishedAt", "artifacts"],
  "properties": {
    "version": {"const": "themis.evidence-bundle/v1alpha1"},
    "serialization": {"const": "go-json-struct-v1"},
    "bundleId": {"$ref": "#/$defs/digest"},
    "source": {"$ref": "#/$defs/source"},
    "publisher": {"$ref": "#/$defs/publisher"},
    "publishedAt": {"$ref": "#/$defs/time"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,191}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optionalDigest": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "set": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "mapping", "experiment", "runId", "contractDigest", "planDigest", "executionPlan", "invocationId", "versions", "candidateVerdict", "execution", "cleanup", "provenance", "missing", "unsupported"],
      "properties": {
        "engine": {"$ref": "#/$defs/id"}, "mapping": {"$ref": "#/$defs/id"},
        "experiment": {"$ref": "#/$defs/id"}, "runId": {"$ref": "#/$defs/id"},
        "contractDigest": {"$ref": "#/$defs/digest"}, "planDigest": {"$ref": "#/$defs/digest"},
        "executionPlan": {"$ref": "#/$defs/optionalDigest"}, "invocationId": {"$ref": "#/$defs/optionalDigest"},
        "versions": {"allOf": [{"$ref": "#/$defs/set"}], "minItems": 1},
        "candidateVerdict": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_RUN"]},
        "execution": {"$ref": "#/$defs/id"}, "cleanup": {"$ref": "#/$defs/id"},
        "provenance": {"const": "RETROSPECTIVE_PUBLICATION"},
        "missing": {"$ref": "#/$defs/set"}, "unsupported": {"$ref": "#/$defs/set"}
      }
    },
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "keyId", "publicKey", "algorithm", "domain"],
      "properties": {
        "name": {"$ref": "#/$defs/id"}, "keyId": {"$ref": "#/$defs/digest"},
        "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
        "algorithm": {"const": "Ed25519"}, "domain": {"const": "themis.evidence-bundle.signature.v1"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "version", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^artifacts/[a-z][a-z0-9-]{0,62}\\.(json|jsonl)$"},
        "role": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "algorithm", "domain", "publisher", "keyId", "signature"],
      "properties": {
        "version": {"const": "themis.evidence-bundle/v1alpha1"}, "algorithm": {"const": "Ed25519"},
        "domain": {"const": "themis.evidence-bundle.signature.v1"}, "publisher": {"$ref": "#/$defs/id"},
        "keyId": {"$ref": "#/$defs/digest"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
