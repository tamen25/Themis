{
    "version":  "themis.postgres-durable/v1alpha1",
    "name":  "durable-recovery",
    "target":  "owned-docker-postgres",
    "workflow":  "pg-logical-persistent-sigkill-v1",
    "storage":  "local-persistent-fixed-workload-v1",
    "failure":  "docker-sigkill",
    "backupMethod":  "pg_dump-custom-1.16.0",
    "restoreMethod":  "pg_restore-single-transaction",
    "timingAnchor":  "last-available-query-start-to-ready",
    "scenario":  "inflight-crash",
    "maxRecoveryMillis":  60000,
    "maxLostCommits":  0,
    "minReceipts":  16,
    "requiredTables":  [
                           "accounts",
                           "health",
                           "transactions"
                       ],
    "integrity":  "exact-receipts-and-constraints",
    "cleanupRequired":  true,
    "maxRuntimeSeconds":  120,
    "maxBackupBytes":  8388608,
    "maxDatabaseBytes":  16777216,
    "maxVolumeBytes":  134217728,
    "maxFileBytes":  8388608
}
